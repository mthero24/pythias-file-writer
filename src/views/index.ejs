<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias File Writer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/react@18.2.0/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/react@11.11.4/dist/emotion-react.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/styled@11.11.0/dist/emotion-styled.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@mui/material@5.15.12/umd/material-ui.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone@7.23.10/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #0d0d0d; overflow: hidden; }
      @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
    </style>
  </head>
  <body>
    <script>
      window._lastFileWritten = <%- JSON.stringify(lastFileWritten || 'Waiting for file…') %>;
    </script>
    <%- include('partials/menu.ejs') %>
    <div id="root"></div>
    <script type="text/babel">
      const {
        ThemeProvider, createTheme, CssBaseline, Box, Typography,
        Card, CardContent, Chip, Button, Tooltip, IconButton,
      } = MaterialUI;
      const { useState, useEffect, useRef } = React;

      const theme = createTheme({
        palette: {
          mode: 'dark',
          primary: { main: '#fedd94', contrastText: '#1a1a1a' },
          background: { default: '#0d0d0d', paper: '#1a1a1a' },
        },
        typography: { fontFamily: '"Roboto", sans-serif' },
        shape: { borderRadius: 10 },
      });

      function formatElapsed(secs) {
        const h = Math.floor(secs / 3600);
        const m = Math.floor((secs % 3600) / 60);
        const s = secs % 60;
        if (h > 0) return `${h}h ${m}m ${s}s ago`;
        if (m > 0) return `${m}m ${s}s ago`;
        return `${s}s ago`;
      }

      const UPDATE_CFG = {
        checking:  { icon: 'fa-rotate',            color: '#888',    bg: 'rgba(255,255,255,0.04)', label: 'Checking for updates…',           btn: null },
        available: { icon: 'fa-circle-down',        color: '#64b5f6', bg: 'rgba(100,181,246,0.08)', label: 'Downloading update…',              btn: null },
        ready:     { icon: 'fa-circle-check',       color: '#fedd94', bg: 'rgba(254,221,148,0.10)', label: 'Update ready — restart to install', btn: 'Restart Now' },
        error:     { icon: 'fa-circle-exclamation', color: '#ef5350', bg: 'rgba(239,83,80,0.08)',   label: 'Update check failed',              btn: null },
      };

      function UpdateBanner({ state, msg, onInstall }) {
        const cfg = UPDATE_CFG[state];
        if (!cfg) return null;
        return (
          <Box sx={{
            display: 'flex', alignItems: 'center', gap: 1.5,
            px: 2, py: 0.75, mb: 2, borderRadius: '8px',
            bgcolor: cfg.bg, border: `1px solid ${cfg.color}30`, flexShrink: 0,
          }}>
            <i className={`fa-solid ${cfg.icon}`} style={{
              color: cfg.color, fontSize: '0.8rem', flexShrink: 0,
              animation: (state === 'checking' || state === 'available') ? 'spin 1.2s linear infinite' : 'none',
            }} />
            <Typography variant="caption" sx={{ color: cfg.color, flexGrow: 1, fontWeight: 500 }}>
              {state === 'error' && msg ? `${cfg.label}: ${msg}` : cfg.label}
            </Typography>
            {cfg.btn && (
              <Button size="small" variant="contained" onClick={onInstall}
                sx={{ bgcolor: '#fedd94', color: '#1a1a1a', fontWeight: 700, py: 0.25, px: 1.5, minWidth: 0, fontSize: '0.75rem', '&:hover': { bgcolor: '#f5ca60' } }}>
                {cfg.btn}
              </Button>
            )}
          </Box>
        );
      }

      function Dashboard() {
        const [lastFile, setLastFile]     = useState(window._lastFileWritten);
        const [elapsed, setElapsed]       = useState(0);
        const [live, setLive]             = useState(true);
        const [updateState, setUpdateState] = useState(null);
        const [updateMsg, setUpdateMsg]   = useState('');
        const timerRef = useRef(0);

        // Poll /update every second and reset timer when file changes
        useEffect(() => {
          const tick = setInterval(async () => {
            try {
              const { data } = await axios.get('/update');
              if (data.lastFileWritten !== lastFile) {
                setLastFile(data.lastFileWritten);
                timerRef.current = 0;
              }
              timerRef.current += 1;
              setElapsed(timerRef.current);
              setLive(true);
            } catch {
              setLive(false);
            }
          }, 1000);
          return () => clearInterval(tick);
        }, [lastFile]);

        // Listen for update events from main process
        useEffect(() => {
          window.electronAPI?.onUpdateStatus?.(({ status, msg }) => {
            setUpdateState(status);
            setUpdateMsg(msg || '');
            if (status === 'current') setTimeout(() => setUpdateState(null), 3000);
            if (status === 'error')   setTimeout(() => setUpdateState(null), 8000);
          });
        }, []);

        const isWaiting = lastFile.toLowerCase().includes('waiting');

        return (
          <ThemeProvider theme={theme}>
            <CssBaseline />
            <Box sx={{
              height: 'calc(100vh - 56px)', overflow: 'hidden',
              bgcolor: 'background.default',
              display: 'flex', flexDirection: 'column',
              alignItems: 'center', justifyContent: 'center',
              p: 3,
            }}>
              <Box sx={{ width: '100%', maxWidth: 560 }}>

                <UpdateBanner state={updateState} msg={updateMsg} onInstall={() => window.electronAPI?.installUpdate()} />

                {/* Logo + title row */}
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 3 }}>
                  <img src="/logoPythias-400.png" alt="Pythias" height="44" />
                  <Box>
                    <Typography variant="h6" sx={{ color: '#fedd94', fontWeight: 700, lineHeight: 1.2 }}>
                      File Writer
                    </Typography>
                    <Typography variant="caption" sx={{ color: '#555' }}>
                      v<%- typeof appVersion !== 'undefined' ? appVersion : '' %> · port 3500
                    </Typography>
                  </Box>
                  <Box sx={{ ml: 'auto', display: 'flex', alignItems: 'center', gap: 1 }}>
                    <Chip
                      icon={<span style={{ width: 7, height: 7, borderRadius: '50%', background: live ? '#4caf50' : '#f44336', display: 'inline-block', marginLeft: 8 }} />}
                      label={live ? 'Online' : 'Error'}
                      size="small"
                      sx={{
                        bgcolor: live ? 'rgba(76,175,80,0.12)' : 'rgba(244,67,54,0.12)',
                        color: live ? '#4caf50' : '#f44336',
                        border: `1px solid ${live ? '#4caf50' : '#f44336'}`,
                        fontWeight: 600,
                      }}
                    />
                    <Tooltip title="Minimize to tray">
                      <IconButton
                        size="small"
                        onClick={() => window.electronAPI?.minimizeToTray()}
                        sx={{ color: '#555', border: '1px solid #2a2a2a', borderRadius: 1, '&:hover': { color: '#fedd94', borderColor: '#fedd94' } }}
                      >
                        <i className="fa-solid fa-window-minimize" style={{ fontSize: '0.8rem' }} />
                      </IconButton>
                    </Tooltip>
                  </Box>
                </Box>

                {/* Last file card */}
                <Card sx={{ bgcolor: '#141414', border: '1px solid #2a2a2a' }}>
                  <CardContent sx={{ p: 2.5, '&:last-child': { pb: 2.5 } }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 1 }}>
                      <i className="fa-solid fa-file-arrow-down" style={{ color: '#fedd94', fontSize: '0.8rem' }} />
                      <Typography variant="caption" sx={{ color: '#555', textTransform: 'uppercase', letterSpacing: 1, fontSize: '0.68rem' }}>
                        Last File Written
                      </Typography>
                    </Box>

                    {isWaiting ? (
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>
                        <i className="fa-solid fa-hourglass-half" style={{ color: '#555', fontSize: '1.1rem', animation: 'pulse 2s ease-in-out infinite' }} />
                        <Typography variant="body1" sx={{ color: '#555', fontStyle: 'italic' }}>
                          Waiting for file…
                        </Typography>
                      </Box>
                    ) : (
                      <>
                        <Typography variant="h6" sx={{ color: '#f0f0f0', fontFamily: 'monospace', fontWeight: 500, wordBreak: 'break-all', mb: 0.5 }}>
                          {lastFile}
                        </Typography>
                        <Typography variant="caption" sx={{ color: '#555', fontFamily: 'monospace' }}>
                          {formatElapsed(elapsed)}
                        </Typography>
                      </>
                    )}
                  </CardContent>
                </Card>

              </Box>
            </Box>
          </ThemeProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<Dashboard />);
    </script>
  </body>
</html>
