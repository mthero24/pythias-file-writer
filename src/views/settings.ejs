<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias Technologies File Writer</title>
    <link rel="stylesheet" href="index.css" />
    <link rel="icon" href="/logo-dark-50.png">
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body style="background: #000; overflow: hidden;">
    <%- include('partials/menu.ejs') %>
    <div style="width: 100%;">
      <div class="row" style="margin-top: 1%;">
        <div class="col-2"> <img src="/logoPythias-400.png" width="100%" height="auto" style="width: 100%; height: auto;"/></div>
        <div class="col-1"></div>
        <div class="col-6">
            <h3 style="text-align: center; font-size: 1.5rem; color: #fff">Hot Folders</h3>
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="DTF Hot Folder" aria-label="Recipient's username" value="<%=settings["dtf"]%>" aria-describedby="basic-addon2" disabled id="dtf">
                <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('dtf')">Select DTF Hot Folder</span>
            </div>
            <div class="input-group mb-3">
              <input type="text" class="form-control" placeholder="Embroidery Hot Folder" aria-label="Recipient's username" value="<%=settings["embroidery"]%>" aria-describedby="basic-addon2" disabled id="embroidery">
              <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('embroidery')">Select Embroidery Hot Folder</span>
          </div>
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="ROQ Hot Folder" aria-label="Recipient's username" value="<%=settings["roq"]%>" aria-describedby="basic-addon2" disabled id="roq">
                <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('roq')">Select ROQ Hot Folder</span>
            </div>
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="11oz Mug Hot Folder" value="<%=settings["11 oz"]%>" aria-label="Recipient's username" aria-describedby="basic-addon2" disabled id="11 oz">
                <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('11 oz')">Select 11oz Mug Hot Folder</span>
            </div>
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="15oz Mug Hot Folder" value="<%=settings["15 oz"]%>" aria-label="Recipient's username" aria-describedby="basic-addon2" disabled id="15 oz">
                <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('15 oz')">Select 15oz Mug Hot Folder</span>
            </div>
             <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="Epson Hot Folder" aria-label="Recipient's username" value="<%=settings["epson"]%>" aria-describedby="basic-addon2" disabled id="epson">
                <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('epson')">Select Epson Hot Folder</span>
            </div>
             <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="Sticker Hot Folder" aria-label="Recipient's username" aria-describedby="basic-addon2" value="<%=settings["stickers"]%>" disabled id="stickers">
                <span class="input-group-text" id="basic-addon2" style="background-color: #fedd94; cursor: pointer" onclick="selectDirectory('stickers')">Select stickers Hot Folder</span>
            </div>
            <h3 style="text-align: center; font-size: 1.5rem; color: #fff">Auto Printers</h3>
            
            <select class="form-select" value="<%=settings["shippingLabelPrinter"]%>" id="label-printer-select" onchange='selectPrinter("shippingLabelPrinter", "label-printer-select")'> 
            </select>
        </div>
        <div class="col-3"></div>
      </div>
      
    </div>
    
    <script type="text/javascript">
      let selectPrinter = async (set, id)=>{
        let printer = document.getElementById(id).value;
        console.log(printer)
        let res = await axios.post("/settings", {path: printer, name:set})
        console.log(res.data)
      }
     let selectDirectory = async (im)=>{
        window.electronAPI.selectFolder().then(async result=>{
            console.log(result)
            document.getElementById(im).value = result
            let res = await axios.post("/settings", {path: result, name:im})
            console.log(res.data)
        })
     }
     let printers 
    window.electronAPI.printers().then(async results =>{
      let sp = "<%=settings['shippingLabelPrinter']%>"
      console.log(results)
      printers = results
      let html = ""
      printers.map(p=> html = `${html}<option value="${p}" selected="${sp == p? true: false}">${p}</option>`)
      console.log(html)
      document.getElementById("label-printer-select").innerHTML = `
        <option>Select Shipping Label Printer</option>
        ${html}
      `
    })
    </script>
  </body>
</html>
