<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias File Writer — Settings</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/react@18.2.0/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/react@11.11.4/dist/emotion-react.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/styled@11.11.0/dist/emotion-styled.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@mui/material@5.15.12/umd/material-ui.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone@7.23.10/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <style>* { box-sizing: border-box; } body { margin: 0; background: #0d0d0d; }</style>
  </head>
  <body>
    <script>
      window._fwSettings = <%- JSON.stringify(settings) %>;
    </script>
    <%- include('partials/menu.ejs') %>
    <div id="root"></div>
    <script type="text/babel">
      const {
        ThemeProvider, createTheme, CssBaseline, Box, Typography,
        Card, CardContent, CardHeader, TextField, Button, IconButton,
        Select, MenuItem, FormControl, InputLabel, Divider,
        Snackbar, Alert, CircularProgress, Tooltip,
      } = MaterialUI;
      const { useState, useEffect } = React;

      const theme = createTheme({
        palette: {
          mode: 'dark',
          primary: { main: '#fedd94', contrastText: '#1a1a1a' },
          background: { default: '#0d0d0d', paper: '#1a1a1a' },
        },
        typography: { fontFamily: '"Roboto", sans-serif' },
        shape: { borderRadius: 10 },
      });

      const HOT_FOLDERS = [
        { key: 'dtf',             label: 'DTF',               icon: 'fa-print' },
        { key: 'embroidery',      label: 'Embroidery',        icon: 'fa-scissors' },
        { key: 'roq',             label: 'ROQ',               icon: 'fa-boxes-stacked' },
        { key: '11 oz',           label: '11oz Mug',          icon: 'fa-mug-hot' },
        { key: '15 oz',           label: '15oz Mug',          icon: 'fa-mug-hot' },
        { key: 'epson',           label: 'Epson',             icon: 'fa-print' },
        { key: 'stickers',        label: 'Stickers',          icon: 'fa-tag' },
        { key: 'poster-pagewide', label: 'Poster (Wide)',     icon: 'fa-file-image' },
        { key: 'poster-epsonhot', label: 'Poster (Epson)',    icon: 'fa-file-image' },
        { key: 'buttons',         label: 'Buttons',           icon: 'fa-circle' },
        { key: 'gift-messages',   label: 'Gift Messages',     icon: 'fa-gift' },
        { key: 'sawgrass',        label: 'Sawgrass',          icon: 'fa-hat-cowboy' },
        { key: 'canvas',          label: 'Canvas',            icon: 'fa-image' },
        { key: 'pagewide',        label: 'Wrapping Paper',    icon: 'fa-scroll' },
        { key: 'socks',           label: 'Socks',             icon: 'fa-socks' },
      ];

      const inputSx = {
        '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } },
        '& .MuiInputLabel-root.Mui-focused': { color: '#fedd94' },
      };

      function FolderRow({ label, icon, value, onChange }) {
        const pick = async () => {
          const path = await window.electronAPI?.selectFolder();
          if (path) onChange(path);
        };
        return (
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5, mb: 1.5 }}>
            <i className={`fa-solid ${icon}`} style={{ color: '#fedd94', fontSize: '0.85rem', width: 16, textAlign: 'center', flexShrink: 0 }} />
            <TextField
              label={label}
              value={value || ''}
              variant="outlined"
              size="small"
              fullWidth
              inputProps={{ readOnly: true, style: { fontFamily: 'monospace', fontSize: '0.82rem' } }}
              placeholder="Not set"
              sx={inputSx}
            />
            <Tooltip title="Browse…">
              <IconButton
                onClick={pick}
                size="small"
                sx={{ border: '1px solid #333', borderRadius: 1, color: '#888', flexShrink: 0, '&:hover': { borderColor: '#fedd94', color: '#fedd94' } }}
              >
                <i className="fa-solid fa-folder-open" style={{ fontSize: '0.85rem' }} />
              </IconButton>
            </Tooltip>
          </Box>
        );
      }

      function SettingsPage() {
        const [settings, setSettings] = useState(window._fwSettings || {});
        const [printers, setPrinters]   = useState([]);
        const [saving, setSaving]       = useState(false);
        const [toast, setToast]         = useState({ open: false, msg: '', severity: 'success' });

        useEffect(() => {
          window.electronAPI?.printers?.().then(list => setPrinters(list || []));
        }, []);

        const showToast = (msg, severity = 'success') => setToast({ open: true, msg, severity });

        const saveSetting = async (key, value) => {
          const next = { ...settings, [key]: value };
          setSettings(next);
          setSaving(true);
          try {
            const { data } = await axios.post('/settings', { name: key, path: value });
            if (data.error) showToast('Save failed', 'error');
            else showToast('Saved');
          } catch {
            showToast('Could not reach server', 'error');
          } finally {
            setSaving(false);
          }
        };

        return (
          <ThemeProvider theme={theme}>
            <CssBaseline />
            <Box sx={{ minHeight: 'calc(100vh - 56px)', bgcolor: 'background.default', p: 3 }}>
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 3 }}>
                <Typography variant="h5" sx={{ color: '#f0f0f0', fontWeight: 700 }}>Settings</Typography>
                {saving && (
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                    <CircularProgress size={14} sx={{ color: '#fedd94' }} />
                    <Typography variant="caption" sx={{ color: '#fedd94' }}>Saving…</Typography>
                  </Box>
                )}
              </Box>

              {/* Hot Folders */}
              <Card sx={{ bgcolor: '#1a1a1a', border: '1px solid #2a2a2a', mb: 2.5 }}>
                <CardHeader
                  avatar={<i className="fa-solid fa-folder" style={{ color: '#fedd94', fontSize: '1rem' }} />}
                  title={<Typography variant="subtitle1" sx={{ fontWeight: 600, color: '#f0f0f0' }}>Hot Folders</Typography>}
                  subheader={<Typography variant="caption" sx={{ color: '#555' }}>Destination paths for each print type</Typography>}
                  sx={{ borderBottom: '1px solid #2a2a2a', pb: 1.5 }}
                />
                <CardContent sx={{ pt: 2 }}>
                  {HOT_FOLDERS.map(f => (
                    <FolderRow
                      key={f.key}
                      label={f.label}
                      icon={f.icon}
                      value={settings[f.key]}
                      onChange={(path) => saveSetting(f.key, path)}
                    />
                  ))}
                </CardContent>
              </Card>

              {/* Printers */}
              <Card sx={{ bgcolor: '#1a1a1a', border: '1px solid #2a2a2a' }}>
                <CardHeader
                  avatar={<i className="fa-solid fa-print" style={{ color: '#fedd94', fontSize: '1rem' }} />}
                  title={<Typography variant="subtitle1" sx={{ fontWeight: 600, color: '#f0f0f0' }}>Auto Printers</Typography>}
                  subheader={<Typography variant="caption" sx={{ color: '#555' }}>Printers used for direct printing operations</Typography>}
                  sx={{ borderBottom: '1px solid #2a2a2a', pb: 1.5 }}
                />
                <CardContent sx={{ pt: 2 }}>
                  {[
                    { key: 'shippingLabelPrinter',   label: 'Shipping Label Printer', icon: 'fa-tag' },
                    { key: 'buttonsPrinter',          label: 'Buttons Printer',        icon: 'fa-circle' },
                    { key: 'giftMessagesPrinter',     label: 'Gift Messages Printer',  icon: 'fa-gift' },
                    { key: 'posterPagewidePrinter',   label: 'Poster (Wide) Printer',  icon: 'fa-file-image' },
                    { key: 'posterEpsonPrinter',      label: 'Poster (Epson) Printer', icon: 'fa-file-image' },
                  ].map(({ key, label, icon }) => (
                    <Box key={key} sx={{ display: 'flex', alignItems: 'center', gap: 1.5, mb: 1.5 }}>
                      <i className={`fa-solid ${icon}`} style={{ color: '#fedd94', fontSize: '0.85rem', width: 16, textAlign: 'center', flexShrink: 0 }} />
                      <FormControl size="small" fullWidth sx={inputSx}>
                        <InputLabel sx={{ '&.Mui-focused': { color: '#fedd94' } }}>{label}</InputLabel>
                        <Select
                          label={label}
                          value={settings[key] || ''}
                          onChange={(e) => saveSetting(key, e.target.value)}
                          sx={{ fontFamily: 'monospace', fontSize: '0.85rem' }}
                        >
                          <MenuItem value=""><em>Select a printer</em></MenuItem>
                          {printers.map(p => (
                            <MenuItem key={p} value={p}>{p}</MenuItem>
                          ))}
                        </Select>
                      </FormControl>
                    </Box>
                  ))}
                  {printers.length === 0 && (
                    <Typography variant="caption" sx={{ color: '#444', display: 'block', mt: 1, ml: 4 }}>
                      No printers detected
                    </Typography>
                  )}
                </CardContent>
              </Card>
            </Box>

            <Snackbar
              open={toast.open}
              autoHideDuration={3000}
              onClose={() => setToast(t => ({ ...t, open: false }))}
              anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
            >
              <Alert severity={toast.severity} sx={{
                bgcolor: toast.severity === 'success' ? 'rgba(76,175,80,0.15)' : 'rgba(211,47,47,0.15)',
                border: `1px solid ${toast.severity === 'success' ? '#4caf50' : '#f44336'}`,
              }}>
                {toast.msg}
              </Alert>
            </Snackbar>
          </ThemeProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<SettingsPage />);
    </script>
  </body>
</html>
